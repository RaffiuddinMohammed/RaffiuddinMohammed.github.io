---
layout: base.njk
title: Markets today
permalink: /dashboards/markets/
description: "A US-led market dashboard: the Magnificent 7 and top US and UK stocks, today's movers, what market news is talking about, Treasury yields and the week's big economic events."
---
<div class="page-head has-photo" style="--photo: url(/assets/img/markets-hero.webp)">
  <div class="eyebrow">Dashboard · Markets</div>
  <h1>Markets today</h1>
  <p class="lede">The Magnificent 7, the biggest US and UK names and what moved today, alongside {{ markets.headlineCount | num }} market headlines from the last two days and the US Treasury yield curve.</p>
</div>

<div class="tv-widget tv-tape" data-widget="ticker-tape" data-config-src="tv-tape"><p class="muted">Loading market prices…</p></div>

{# ---------- The week ahead: written from calendar.json (dates and names only: no forecasts) ---------- #}
{% if calendar.days and calendar.days.length %}
{% set bigE = [] %}{% set keyEv = [] %}{% set shut = [] %}
{% for d in calendar.days %}
  {% for e in d.earnings %}{% if e.big %}{% set bigE = (bigE.push({ d: d, e: e }), bigE) %}{% endif %}{% endfor %}
  {% for v in d.events %}{% if not ('jobless' in v.what or 'speaks' in v.what) %}{% set keyEv = (keyEv.push({ d: d, v: v }), keyEv) %}{% endif %}{% endfor %}
  {% if d.closed %}{% set shut = (shut.push(d.label + ': US markets closed (' + d.closed + ')'), shut) %}{% endif %}
  {% if d.early %}{% set shut = (shut.push(d.label + ': US markets close early (' + d.early + ')'), shut) %}{% endif %}
{% endfor %}
{% endif %}

{# ---------- Prices: TradingView widgets (delayed quotes, licensed for embedding) ---------- #}
<section>
  <div class="card">
    <h2>The Magnificent 7</h2>
    <p class="muted">Three months of price for each. Pick a tab to switch company. Prices are delayed about 15 minutes.</p>
    <div class="tv-widget" data-widget="symbol-overview" data-config-src="tv-mag7" data-height="420"></div>
  </div>
</section>

<section class="grid two">
  <div class="card">
    <h2>Watchlist</h2>
    <p class="muted">Today's price and change: Magnificent 7, more US leaders and the FTSE 100's biggest names. Delayed about 15 minutes.</p>
    <div class="tv-widget" data-widget="market-quotes" data-config-src="tv-quotes" data-height="520"></div>
  </div>
  <div class="card">
    <h2>Today's US movers</h2>
    <p class="muted">Biggest gainers, losers and most active US stocks.</p>
    <div class="tv-widget" data-widget="hotlists" data-config-src="tv-movers" data-height="520"></div>
  </div>
</section>

<section>
  <div class="card">
    <h2>The S&amp;P 500 at a glance</h2>
    <p class="muted">Each block is a company, sized by market value and coloured by today's move. The Magnificent 7 are the biggest blocks.</p>
    <div class="tv-widget tv-heatmap" data-widget="stock-heatmap" data-config-src="tv-heatmap" data-height="520"></div>
  </div>
</section>

{# ---------- News: built here from RSS ---------- #}
{% set th = { label: 'Market headlines by theme', unit: 'headlines', rows: [] } %}
{% for t in markets.themes %}{% if t.count %}{% set th = (th.rows.push({ label: t.name, value: t.count }), th) %}{% endif %}{% endfor %}
{% set m7 = { label: 'Magnificent 7 mentions in market headlines', unit: 'headlines', rows: [] } %}
{% for t in markets.mag7 %}{% set m7 = (m7.rows.push({ label: t.name, value: t.count }), m7) %}{% endfor %}

<section>
  <div class="page-head" style="padding-top:16px">
    <div class="eyebrow">News · last 48 hours</div>
    <h2 style="font-size:1.6rem">What the market is talking about</h2>
    <p class="muted">{{ markets.headlineCount | num }} headlines from {% for s in markets.sources %}{{ s.name }}{% if not loop.last %}{{ ' and ' if loop.revindex0 == 1 else ', ' }}{% endif %}{% endfor %}, sorted into themes.</p>
  </div>
  <div class="grid two">
    <div class="card chart-card">
      <h2>Themes in the headlines</h2>
      <p class="muted">Headlines mentioning each theme. One headline can count towards several.</p>
      <div class="chart" data-chart="bar" data-src="themes-data"></div>
      <details class="table"><summary>View as table</summary><div class="tablewrap"><table>
        <thead><tr><th>Theme</th><th>Headlines</th></tr></thead>
        <tbody>{% for t in markets.themes %}<tr><td>{{ t.name }}</td><td>{{ t.count }}</td></tr>{% endfor %}</tbody>
      </table></div></details>
    </div>
    <div class="card chart-card">
      <h2>Magnificent 7 in the news</h2>
      <p class="muted">Headlines naming each company, its ticker or its best-known products.</p>
      <div class="chart" data-chart="bar" data-src="mag7-data"></div>
      <details class="table"><summary>View as table</summary><div class="tablewrap"><table>
        <thead><tr><th>Company</th><th>Headlines</th></tr></thead>
        <tbody>{% for t in markets.mag7 %}<tr><td>{{ t.name }}</td><td>{{ t.count }}</td></tr>{% endfor %}</tbody>
      </table></div></details>
    </div>
  </div>
</section>

<section id="market-headlines">
  <div class="card">
    <h2>Latest market headlines</h2>
    <ul class="storylist">
      {% for s in markets.latest %}
      <li><a href="{{ s.link }}" rel="noopener" target="_blank">{{ s.title }}</a><div class="meta">{{ s.source }} · {{ s.date | ago }}</div></li>
      {% endfor %}
    </ul>
  </div>
</section>

{# ---------- Rates: US Treasury (public domain) ---------- #}
{% if markets.yields %}
{% set y = markets.yields %}
{% set yc = { label: 'US Treasury yields, last three months', unit: '%', yMin: y.chartFloor or 0, series: [
  { label: '2-year', slot: 1, points: [] }, { label: '10-year', slot: 2, points: [] }, { label: '30-year', slot: 3, points: [] } ] } %}
{% for r in y.history %}{% if r.y2 != null and r.y30 != null %}
  {% set _ = yc.series[0].points.push({ date: r.date, value: r.y2 }) %}{% set _ = yc.series[1].points.push({ date: r.date, value: r.y10 }) %}{% set _ = yc.series[2].points.push({ date: r.date, value: r.y30 }) %}
{% endif %}{% endfor %}
<section>
  <div class="page-head" style="padding-top:16px">
    <div class="eyebrow">Rates · US Treasury</div>
    <h2 style="font-size:1.6rem">The price of money</h2>
    <p class="muted">Treasury yields set the cost of borrowing across the economy. Rising yields usually weigh on share prices, especially tech.</p>
  </div>
  <div class="grid three">
    {% for k in [['y2', '2-year', 1], ['y10', '10-year', 2], ['y30', '30-year', 3]] %}
    {% set now = y.latest[k[0]] %}{% set was = y.monthAgo[k[0]] %}{% set diff = ((now - was) * 100) | round %}
    <div class="card stat tint-{{ k[2] }} reveal">
      <div class="value">{{ now.toFixed(2) }}%</div>
      <div class="label">{{ k[1] }} yield · {% if diff > 0 %}up {{ diff }}{% elif diff < 0 %}down {{ -diff }}{% else %}unchanged,{% endif %}{% if diff != 0 %} basis points{% endif %} in a month</div>
    </div>
    {% endfor %}
  </div>
  <div class="card chart-card" style="margin-top:16px">
    <h2>Yields over three months</h2>
    <p class="muted">Daily closing yield. Hover for values.</p>
    <div class="chart" data-chart="line" data-src="yields-data"></div>
  </div>
  <p class="muted">Source: <a href="https://home.treasury.gov/resource-center/data-chart-center/interest-rates" rel="noopener">US Department of the Treasury</a>, as of {{ y.latest.date }}.</p>
</section>
<script type="application/json" id="yields-data">{{ yc | json | safe }}</script>
{% endif %}


{% if calendar.days and calendar.days.length %}
<section class="card week-ahead tint-5">
  <div class="eyebrow">The week ahead · {{ calendar.days[0].label }} to {{ calendar.days[calendar.days.length - 1].label }}</div>
  <h2>What to watch this week</h2>
  <div class="wa-grid">
    <div>
      <h3>📣 Big earnings</h3>
      {% if bigE.length %}<ul class="wa-list">
        {% for x in bigE.slice(0, 8) %}<li><span class="logo-tile" aria-hidden="true"><span class="logo-letter">{{ x.e.name[0] }}</span><img src="https://financialmodelingprep.com/image-stock/{{ x.e.symbol | urlencode }}.png" alt="" width="22" height="22" loading="lazy" decoding="async" crossorigin="anonymous" referrerpolicy="no-referrer" onerror="this.remove()"></span><b>{{ x.e.name }}</b>{% if x.e.mag7 %} <span class="badge mag7">Mag 7</span>{% endif %} <span class="muted">{{ x.d.label }}, {{ 'before the open' if x.e.when == 'before' else ('after the close' if x.e.when == 'after' else 'time tbc') }}</span></li>{% endfor %}
      </ul>{% else %}<p class="muted">No companies over $100 billion report this week.</p>{% endif %}
      <a class="go-link" href="#earnings">Full earnings calendar ↓</a>
    </div>
    <div>
      <h3>📊 Key data and central banks</h3>
      {% if keyEv.length %}<ul class="wa-list">
        {% for x in keyEv.slice(0, 8) %}<li><span class="flag">{{ '🇺🇸' if x.v.country == 'US' else '🇬🇧' }}</span><b>{{ x.v.what }}</b> <span class="muted">{{ x.d.label }}{% if x.v.time %}, {{ x.v.time }} UK{% endif %}{% if x.v.previous %} · last {{ x.v.previous }}{% endif %}{% if x.v.consensus %} · expected {{ x.v.consensus }}{% endif %}</span></li>{% endfor %}
      </ul>{% else %}<p class="muted">A quiet week for major US and UK data.</p>{% endif %}
    </div>
    <div>
      <h3>🧭 Backdrop</h3>
      <ul class="wa-list">
        {% for x in shut %}<li><b>📅 {{ x }}</b></li>{% endfor %}
        {% if markets.themes[0].count %}<li><b>{{ markets.themes[0].name }}</b> is the biggest theme in market news: {{ markets.themes[0].count }} of {{ markets.headlineCount }} headlines.</li>{% endif %}
        {% if markets.yields %}{% set y = markets.yields %}{% set dy = ((y.latest.y10 - y.monthAgo.y10) * 100) | round %}<li>The US 10-year yield is <b>{{ y.latest.y10.toFixed(2) }}%</b>, {{ 'up' if dy > 0 else ('down' if dy < 0 else 'flat') }}{% if dy != 0 %} {{ dy | abs }} basis points{% endif %} on a month ago.</li>{% endif %}
        {% if markets.mag7[0].count %}<li><b>{{ markets.mag7[0].name }}</b> is the Magnificent 7 name most in the news.</li>{% endif %}
      </ul>
    </div>
  </div>
  <p class="muted wa-note">Built automatically from public calendars. It lists what's scheduled, not what will happen: not financial advice.</p>
</section>

<section id="earnings">
  <div class="card">
    <h2>Earnings calendar</h2>
    <p class="muted">US-listed companies worth over $10 billion reporting results in the next week, biggest first. <span class="badge big">Big</span> = worth over $100 billion. EPS forecast is the analysts' average estimate of earnings per share.</p>
    <div class="earn-days">
    {% for d in calendar.days %}
      <div class="earn-day{% if d.closed %} closed{% endif %}">
        <h3>{{ d.label }}{% if loop.first %} <span class="muted">· today</span>{% endif %}</h3>
        {% if d.closed %}<p class="muted">US markets closed: {{ d.closed }}</p>
        {% elif d.earnings.length %}
        <ul class="earn-list">
          {% for e in d.earnings %}<li class="{{ 'is-big' if e.big }}">
            <span class="e-name"><span class="logo-tile" aria-hidden="true"><span class="logo-letter">{{ e.name[0] }}</span><img src="https://financialmodelingprep.com/image-stock/{{ e.symbol | urlencode }}.png" alt="" width="22" height="22" loading="lazy" decoding="async" crossorigin="anonymous" referrerpolicy="no-referrer" onerror="this.remove()"></span><b>{{ e.name }}</b> <span class="muted">{{ e.symbol }}</span>{% if e.mag7 %} <span class="badge mag7">Mag 7</span>{% elif e.big %} <span class="badge big">Big</span>{% endif %}</span>
            <span class="e-meta"><span title="{{ 'Reports before the US market opens' if e.when == 'before' else ('Reports after the US market closes' if e.when == 'after' else 'Time not announced') }}">{{ '☀️ Before open' if e.when == 'before' else ('🌙 After close' if e.when == 'after' else '⏱ Time tbc') }}</span> · {{ e.capText }}{% if e.eps %} · EPS est. {{ e.eps }}{% endif %}</span>
          </li>{% endfor %}
        </ul>
        {% else %}<p class="muted">No large companies reporting.</p>{% endif %}
        {% if d.early %}<p class="muted">US markets close early: {{ d.early }}</p>{% endif %}
      </div>
    {% endfor %}
    </div>
    <p class="muted credit">Source: <a href="https://www.nasdaq.com/market-activity/earnings" rel="noopener">Nasdaq earnings calendar</a>, US-listed companies only. Logos via <a href="https://financialmodelingprep.com/" rel="noopener">Financial Modeling Prep</a>. Updated {{ calendar.updated | when }}.</p>
  </div>
</section>
{% endif %}

<section>
  <div class="card">
    <h2>Coming up</h2>
    <p class="muted">The US and UK economic releases and central bank decisions that move markets: rate decisions, inflation and jobs data.</p>
    <div class="tv-widget" data-widget="events" data-config-src="tv-events" data-height="520"></div>
  </div>
  <p class="muted disclaimer"><b>Not financial advice.</b> Stock and index prices are delayed about 15 minutes (a <b>D</b> next to a price marks it as delayed) and come from <a href="https://www.tradingview.com/" rel="noopener">TradingView</a>; headlines link to their publishers; nothing here is a recommendation to buy or sell. See the <a href="/terms/">terms and disclaimer</a>. News updated {{ markets.updated | when }}.</p>
</section>

<script type="application/json" id="themes-data">{{ th | json | safe }}</script>
<script type="application/json" id="mag7-data">{{ m7 | json | safe }}</script>

{# Widget configs. Symbols use TradingView's names; FOREXCOM/OANDA CFDs stand in for indices, which exchanges don't licence for free embeds. #}
<script type="application/json" id="tv-tape">{"symbols":[
  {"proName":"FOREXCOM:SPXUSD","title":"S&P 500"},{"proName":"FOREXCOM:NSXUSD","title":"Nasdaq 100"},{"proName":"FOREXCOM:DJI","title":"Dow Jones"},
  {"proName":"FOREXCOM:UKXGBP","title":"FTSE 100"},{"proName":"FX:GBPUSD","title":"GBP/USD"},{"proName":"OANDA:XAUUSD","title":"Gold"},
  {"proName":"TVC:USOIL","title":"US oil"},{"proName":"BITSTAMP:BTCUSD","title":"Bitcoin"}],
  "showSymbolLogo":true,"displayMode":"adaptive"}</script>
<script type="application/json" id="tv-mag7">{"symbols":[
  ["Apple","NASDAQ:AAPL|3M"],["Microsoft","NASDAQ:MSFT|3M"],["Nvidia","NASDAQ:NVDA|3M"],["Alphabet","NASDAQ:GOOGL|3M"],
  ["Amazon","NASDAQ:AMZN|3M"],["Meta","NASDAQ:META|3M"],["Tesla","NASDAQ:TSLA|3M"]],
  "chartOnly":false,"chartType":"area","showVolume":false,"hideDateRanges":false,"scalePosition":"right","scaleMode":"Normal",
  "dateRanges":["1d|1","1m|30","3m|60","12m|1D","60m|1W"]}</script>
<script type="application/json" id="tv-quotes">{"showSymbolLogo":true,"symbolsGroups":[
  {"name":"Magnificent 7","symbols":[{"name":"NASDAQ:AAPL","displayName":"Apple"},{"name":"NASDAQ:MSFT","displayName":"Microsoft"},{"name":"NASDAQ:NVDA","displayName":"Nvidia"},{"name":"NASDAQ:GOOGL","displayName":"Alphabet"},{"name":"NASDAQ:AMZN","displayName":"Amazon"},{"name":"NASDAQ:META","displayName":"Meta"},{"name":"NASDAQ:TSLA","displayName":"Tesla"}]},
  {"name":"US leaders","symbols":[{"name":"NASDAQ:AVGO","displayName":"Broadcom"},{"name":"NYSE:BRK.B","displayName":"Berkshire Hathaway"},{"name":"NYSE:JPM","displayName":"JPMorgan Chase"},{"name":"NYSE:LLY","displayName":"Eli Lilly"},{"name":"NYSE:V","displayName":"Visa"},{"name":"NYSE:WMT","displayName":"Walmart"},{"name":"NYSE:ORCL","displayName":"Oracle"},{"name":"NASDAQ:NFLX","displayName":"Netflix"},{"name":"NYSE:XOM","displayName":"Exxon Mobil"},{"name":"NASDAQ:COST","displayName":"Costco"}]},
  {"name":"UK leaders","symbols":[{"name":"LSE:AZN","displayName":"AstraZeneca"},{"name":"LSE:SHEL","displayName":"Shell"},{"name":"LSE:HSBA","displayName":"HSBC"},{"name":"LSE:ULVR","displayName":"Unilever"},{"name":"LSE:RR.","displayName":"Rolls-Royce"},{"name":"LSE:BP.","displayName":"BP"}]}]}</script>
<script type="application/json" id="tv-movers">{"exchange":"US","showChart":true,"showSymbolLogo":true,"showFloatingTooltip":false}</script>
<script type="application/json" id="tv-heatmap">{"exchanges":[],"dataSource":"SPX500","grouping":"sector","blockSize":"market_cap_basic","blockColor":"change","hasTopBar":false,"isDataSetEnabled":false,"isZoomEnabled":true,"hasSymbolTooltip":true,"isMonoSize":false}</script>
<script type="application/json" id="tv-events">{"importanceFilter":"0,1","countryFilter":"us,gb"}</script>
<script src="/assets/markets.js" defer></script>
