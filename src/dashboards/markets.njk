  {"proName":"FOREXCOM:SPXUSD","title":"S&P 500"},{"proName":"FOREXCOM:NSXUSD","title":"Nasdaq 100"},{"proName":"FOREXCOM:DJI","title":"Dow Jones"},
  {"proName":"FOREXCOM:UKXGBP","title":"FTSE 100"},{"proName":"FX:GBPUSD","title":"GBP/USD"},{"proName":"OANDA:XAUUSD","title":"Gold"},
  {"proName":"TVC:USOIL","title":"US oil"},{"proName":"BITSTAMP:BTCUSD","title":"Bitcoin"}],
  "showSymbolLogo":true,"displayMode":"adaptive"}</script>
