<div class="phone" aria-hidden="true">
  <div class="phone-notch"></div>
  <div class="phone-status"><span>9:41</span><span>●●● ▮</span></div>
  <div class="phone-screen">
    <!-- 1. sign in -->
    <section class="app-screen active" data-screen="login">
      <div class="app-brand"><span class="app-logo">🌿</span><b>Bloom</b><small>Plants, delivered</small></div>
      <label class="app-field"><span>Email</span><input data-id="email" type="text" tabindex="-1" readonly placeholder="you@example.com"></label>
      <label class="app-field"><span>Password</span><input data-id="password" type="text" tabindex="-1" readonly placeholder="••••••••"></label>
      <div class="app-btn" data-id="sign-in">Sign in</div>
      <p class="app-small">New here? <u>Create an account</u></p>
    </section>
    <!-- 2. shop -->
    <section class="app-screen" data-screen="home">
      <header class="app-bar"><b data-id="home-title">Good morning 🌱</b><span class="app-basket" data-id="basket">🛒<i data-id="basket-badge">0</i></span></header>
      <p class="app-small">Hand-picked for your windowsill</p>
      <div class="app-card" data-id="product-monstera"><span class="app-emoji">🪴</span><div><b>Monstera</b><small>Easy care · 60 cm</small></div><em>£24</em></div>
      <div class="app-card"><span class="app-emoji">🌵</span><div><b>Golden barrel</b><small>Full sun · 20 cm</small></div><em>£16</em></div>
      <div class="app-card"><span class="app-emoji">🌿</span><div><b>Snake plant</b><small>Low light · 45 cm</small></div><em>£18</em></div>
    </section>
    <!-- 3. product -->
    <section class="app-screen" data-screen="product">
      <header class="app-bar"><span>‹ Back</span><span class="app-basket" data-id="basket">🛒<i data-id="basket-badge">0</i></span></header>
      <div class="app-hero">🪴</div>
      <b class="app-title">Monstera deliciosa</b>
      <p class="app-small">A forgiving classic with big, split leaves. Water every 1–2 weeks.</p>
      <div class="app-price">£24.00</div>
      <div class="app-btn" data-id="add-to-basket">Add to basket</div>
    </section>
    <!-- 4. basket -->
    <section class="app-screen" data-screen="basket">
      <header class="app-bar"><span>‹ Shop</span><b>Basket</b><span></span></header>
      <div class="app-card"><span class="app-emoji">🪴</span><div><b>Monstera</b><small>Qty 1</small></div><em>£24</em></div>
      <div class="app-total"><span>Delivery</span><span>Free</span></div>
      <div class="app-total big"><span>Total</span><span>£24.00</span></div>
      <div class="app-btn" data-id="checkout">Checkout</div>
    </section>
    <!-- 5. done -->
    <section class="app-screen" data-screen="done">
      <div class="app-done" data-id="order-confirmed"><div class="app-tick">✓</div><b>Order confirmed</b><small>#BL-2041 · arriving Thursday</small></div>
    </section>
    <div class="touch"></div>
  </div>
</div>
