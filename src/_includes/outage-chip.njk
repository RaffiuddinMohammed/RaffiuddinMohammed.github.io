{# Outage status + RSS at the right end of the news bars: always visible, without taking over the bar #}
{% if outages.services %}
{% set downAll = outages.services | rejectLevel('ok') %}
{% set worst = 'major' if (outages.services | atLevel('major')).length else ('minor' if downAll.length else 'ok') %}
<a class="outage-chip lvl-{{ worst }}" href="/dashboards/outages/" title="{% if downAll.length %}Reporting problems: {% for o in downAll %}{{ o.name }}{{ ', ' if not loop.last }}{% endfor %}{% else %}All {{ outages.services.length }} services running normally{% endif %} · checked {{ outages.checked | when }}" aria-label="Outage watch: {% if downAll.length %}{{ downAll.length }} service{{ 's' if downAll.length != 1 }} reporting problems{% else %}all services running normally{% endif %}">
  <span class="st-dot" aria-hidden="true"></span>{% if downAll.length %}<span class="oc-long">{{ downAll.length }} outage{{ 's' if downAll.length != 1 }}</span><span class="oc-short">{{ downAll.length }}</span>{% else %}<span class="oc-long">All services OK</span><span class="oc-short">OK</span>{% endif %}
</a>
<a class="flash-rss" href="/dashboards/outages/feed.xml" title="Get outage alerts in your feed reader" aria-label="Subscribe to Outage watch by RSS"><svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true"><circle cx="3" cy="13" r="2" fill="currentColor"/><path d="M1 7a8 8 0 0 1 8 8M1 2a13 13 0 0 1 13 13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg><span class="oc-long">RSS</span></a>
{% endif %}
