<!doctype html>
<html lang="en-GB" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/style.css">
  <script>document.documentElement.classList.replace('no-js', 'js')</script>
</head>
<body>
  <header class="topbar">
    <nav class="wrap nav">
      <a class="brand" href="/"><span class="logo" aria-hidden="true">{{ site.shortName | first }}</span><span class="full">{{ site.name }}</span><span class="short">{{ site.shortName }}</span></a>
      {% set here = page.url %}
      <div class="links">
        <a class="pill n1{% if here.startsWith('/dashboards/') %} active{% endif %}" href="/#dashboards"{% if here.startsWith('/dashboards/') %} aria-current="page"{% endif %}><span class="ico" aria-hidden="true">📊</span>Dashboards</a>
        <a class="pill n2{% if here == '/about/' %} active{% endif %}" href="/about/"{% if here == '/about/' %} aria-current="page"{% endif %}><span class="ico" aria-hidden="true">👋</span>About</a>
        <a class="pill n3 hide-sm" href="{{ site.github }}" rel="noopener"><span class="ico" aria-hidden="true">⭐</span>GitHub<span class="arr" aria-hidden="true">↗</span></a>
        <a class="pill cta" href="/about/#for-business">Work with me</a>
      </div>
    </nav>
  </header>
  <main class="wrap">
    {{ content | safe }}
  </main>
  <footer class="wrap footer">
    <p>Built with Eleventy, hosted free on GitHub Pages. Data refreshes daily from GDELT, BBC News and Hacker News.</p>
  </footer>
  <script src="/assets/charts.js"></script>
  <script src="/assets/site.js"></script>
</body>
</html>
