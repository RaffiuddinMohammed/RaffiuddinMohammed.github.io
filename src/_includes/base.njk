<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <header class="topbar">
    <nav class="wrap nav">
      <a class="brand" href="/">{{ site.name }}</a>
      <div class="links">
        <a href="/#dashboards">Dashboards</a>
        <a href="/about/">About</a>
        <a href="{{ site.github }}" rel="noopener">GitHub</a>
      </div>
    </nav>
  </header>
  <main class="wrap">
    {{ content | safe }}
  </main>
  <footer class="wrap footer">
    <p>Built with Eleventy, hosted free on GitHub Pages. Data refreshes daily from GDELT, BBC News and Hacker News.</p>
  </footer>
  <script src="/assets/charts.js"></script>
</body>
</html>
